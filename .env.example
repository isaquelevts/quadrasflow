NODE_ENV=production
PORT=3000
DATA_DIR=./data
APP_BASE_URL=https://app.seudominio.com.br

# Use estes valores apenas para criar o primeiro administrador da plataforma.
# Remova BOOTSTRAP_PASSWORD do arquivo depois do primeiro uso.
BOOTSTRAP_EMAIL=admin@seudominio.com.br
BOOTSTRAP_NAME=Administrador QuadrasFlow
BOOTSTRAP_PASSWORD=troque-por-uma-senha-longa-e-unica

# Deploy com Docker Compose/Caddy
DOMAIN=app.seudominio.com.br

# WAHA: use URL de rede privada acessível pelo container do app.
# Para WAHA executando no host VPS, host.docker.internal pode funcionar.
WAHA_BASE_URL=http://host.docker.internal:3001
WAHA_API_KEY=configure-fora-do-repositorio
WAHA_WEBHOOK_SECRET=gere-um-segredo-aleatorio-longo

# Agente de atendimento WhatsApp. Configure a chave no ambiente seguro do servidor.
OPENAI_API_KEY=
WHATSAPP_AI_MODEL=gpt-4.1-mini

# Mercado Pago Marketplace: OAuth para cada arena receber em sua própria conta.
# A URL de callback deve ser cadastrada na aplicação Mercado Pago como:
# https://app.seudominio.com.br/api/integrations/mercadopago/callback
MERCADOPAGO_APP_ID=
MERCADOPAGO_CLIENT_SECRET=
# Gere 32 bytes aleatórios e informe em hexadecimal (64 caracteres). Guarde fora do repositório.
MERCADOPAGO_ENCRYPTION_KEY=
# Segredo Webhook configurado no painel da aplicação do Mercado Pago.
MERCADOPAGO_WEBHOOK_SECRET=

# Configure um destino remoto do rclone para manter backups fora da VPS.
BACKUP_REMOTE=quadrasflow-backups:prod
RCLONE_CONFIG_PATH=/opt/quadrasflow/rclone.conf
