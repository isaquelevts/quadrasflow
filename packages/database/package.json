{
  "name": "@quadrasflow/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:import-sqlite": "node scripts/import-sqlite.mjs"
  },
  "dependencies": { "drizzle-orm": "^0.45.3", "postgres": "^3.4.7" },
  "devDependencies": { "drizzle-kit": "^0.31.4", "typescript": "^5.9.3" }
}
